      {"id": "approval", "text": "待审批逐项核对动作\n批准选中项或驳回全部", "kind": "manual", "row": 4, "col": 1},
      {"id": "reject", "text": "驳回或未选动作\n不得进入该动作执行", "kind": "end", "row": 4, "col": 0},
