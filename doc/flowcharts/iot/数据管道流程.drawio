        <mxCell id="c2" value="XACK 确认消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st3">
          <mxGeometry x="160" y="170" width="340" height="60" as="geometry" />
