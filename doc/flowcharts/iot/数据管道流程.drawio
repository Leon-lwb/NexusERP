<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.5">
  <diagram name="Page-1">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st1" value="① 设备接入（MQTT）" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;fontColor=#7a5c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="40" width="960" height="500" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="设备注册 IotDevice&#xa;（deviceCode + deviceSecret 认证）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="st1">
          <mxGeometry x="160" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="MQTT Broker 内嵌（Moquette）&#xa;端口 1883 / QoS 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st1">
          <mxGeometry x="160" y="160" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Topic 规范&#xa;iot/{tenantId}/{deviceId}/property/post&#xa;（属性上报 / set 设置 / event 事件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="st1">
          <mxGeometry x="160" y="270" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="遗嘱消息 → 设备离线&#xa;更新 iot_device.connection_status = OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st1">
          <mxGeometry x="160" y="390" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="② 数据管道（Redis Streams）" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;fontColor=#7a5c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="580" width="960" height="560" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="MqttMessageListener 接收&#xa;解析 Topic + 提取属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st2">
          <mxGeometry x="160" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="XADD iot:data:stream&#xa;（device_id + property_code + value）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st2">
          <mxGeometry x="160" y="160" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="StreamConsumer XREADGROUP&#xa;（GROUP iot-consumers BLOCK 1000）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st2">
          <mxGeometry x="160" y="270" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="写入 iot_device_data 表&#xa;（MySQL 批量 INSERT）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st2">
          <mxGeometry x="160" y="380" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="HSET iot:latest:{deviceId}&#xa;SET iot:status:{deviceId} ONLINE EX 3600" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="st2">
          <mxGeometry x="160" y="490" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st3" value="③ 实时推送（SSE）" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;fontColor=#7a5c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1180" width="960" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="告警阈值检查&#xa;（硬编码 / 温度 &gt; 80 等）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="st3">
          <mxGeometry x="160" y="50" width="340" height="72" as="geometry" />
