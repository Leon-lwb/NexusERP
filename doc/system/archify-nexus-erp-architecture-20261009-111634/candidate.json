  "cards": [
    {
      "dot": "cyan",
      "title": "四端入口与业务分工",
      "items": [
        "PC / plus-ui：业务人员与管理员的 Web 管理端",
        "APP / Nexus-App：员工与管理者的考勤、IM、移动业务与 AI 入口",
        "PDA / nexus-pda：仓储、产线、质检与设备人员的现场扫码作业",
        "Station / nexus-station：固定工位的烧录、综测、SN 过站、SOP 与上料"
      ]
    },
    {
      "dot": "rose",
      "title": "连接与执行边界",
      "items": [
        "PC、APP、PDA 使用登录态业务 API；PDA 写操作另受权限与幂等校验",
        "Station 使用 X-API-KEY 设备 HTTP 通道，不等于普通员工登录态",
        "工位机通过配置的串口 / 厂商 CLI 驱动控制外设；不把 mock 当成真机验收",
        "MQTT 工业设备单列：设备认证与 Topic 授权，不与工位机或 PDA 混同"
      ]
    },
    {
      "dot": "emerald",
      "title": "制造与平台服务",
      "items": [
        "ERP / MES / IoT / AI / Flow 由 ruoyi-admin 组装在 NexusServer 内",
        "ruoyi-station 是后端设备通道模块；nexus-station 是独立 Electron 客户端",
        "System / IM / Flowable / Pay / Report / Job 及鉴权、租户、签章等共享能力",
        "不把代码模块误画成独立微服务；RabbitMQ 承载跨模块异步事件"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 与知识库的数据分工",
      "items": [
        "模型服务：按配置选择对话 / Agent / Embedding 模型",
        "MinIO / S3 存原始文件；MySQL 存业务数据、知识文档与分块元数据",
        "Embedding 模型生成向量；milvus 模式由 Milvus 存储并进行相似检索",
        "Milvus 按 knowledgeId 分 Collection；工业动作受策略与审批约束"
      ]
    },
    {
      "dot": "slate",
      "title": "证据与运行范围",
      "items": [
        "四个仓库分别固定提交；图中原生来源验证 ERP 后端契约，客户端证据另存",
        "Nginx 只画仓库可证明的静态目录关系，不推断外置 API 代理配置",
        "Milvus 部署位置与线上向量模式未核验；辅助监控 / 调度未展开为部署拓扑",
        "本图是逻辑总览，未连接真实数据库、模型服务、PDA 真机或工位硬件"
      ]
    }
  ]
}
