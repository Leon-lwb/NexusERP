  "cards": [
    {
      "dot": "cyan",
      "title": "PC 与 PDA 作业入口",
      "items": [
        "PC：Vue 3 管理端，经 API 与 SSE 访问业务",
        "PDA：独立 nexus-pda 项目，uni-app + Vue 3",
        "PDA 面向仓储、生产、质检与设备人员的扫码作业",
        "/app/pda/** 使用登录态；写操作受权限与幂等校验"
      ]
    },
    {
      "dot": "emerald",
      "title": "制造业务与工业接入",
      "items": [
        "ERP：基础数据、销售、采购、生产计划、排产与仓储",
        "MES：工单、报工、质量、设备与追溯",
        "Station：工位设备通道，与 PDA 移动作业前端分工",
        "MQTT 设备认证、工位 HTTP 密钥与 PDA 登录态不可混同"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 与知识库数据分工",
      "items": [
        "AI / Flow：对话、工具查询、RAG 与受保护工业编排",
        "MinIO / S3：知识库原始文件；MySQL：文档与分块元数据",
        "Embedding 模型生成向量；Milvus 保存向量并执行相似检索",
        "Milvus 按 knowledgeId 分 Collection；向量后端由配置选择"
      ]
    },
    {
      "dot": "amber",
      "title": "平台与共享基础",
      "items": [
        "System / IM / Flowable / Pay / Report / Job 支撑业务",
        "共享鉴权、租户、幂等、SSE 与电子签章能力",
        "业务模块由 NexusServer 同进程组装，不等于独立微服务"
      ]
    },
    {
      "dot": "slate",
      "title": "代码与运行边界",
      "items": [
        "ERP 基线 515206db；PDA 客户端基线 6f75c489",
        "JSON 来源引用验证 ERP 后端；PDA 客户端证据单独记录",
        "Milvus 不在根双机 Compose 中，部署位置与运行配置未核验",
        "Nginx API 转发由部署挂载文件决定；不推断未纳入仓库的路由",
        "本次未连接真实数据库、PDA 真机、设备或外部模型服务"
      ]
    }
  ]
