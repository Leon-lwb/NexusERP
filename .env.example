# NexusERP Docker 部署环境变量
# 复制本文件为 .env 并填入真实密码；.env 不入仓库（已 gitignore）。
# 密码须与 application-prod.yml / application-secret.yml 中保持一致。
#
# 部署时 docker compose 会自动读取同目录下的 .env。

# MySQL root 密码（与 application-prod.yml 的 master/erp 数据源密码一致）
MYSQL_ROOT_PASSWORD=

# RabbitMQ 密码（账号 nexus 在 compose 中写死，密码在此；至少不要太简单）
RABBITMQ_DEFAULT_PASS=

# MinIO 密码（账号 minio 在 compose 中写死，密码在此；至少 8 字符）
MINIO_ROOT_PASSWORD=
