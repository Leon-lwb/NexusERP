# NexusERP Docker 部署环境变量
# 复制本文件为 .env 并填入真实密码；.env 不入仓库（已 gitignore）。
# 密码须与 application-prod.yml / application-secret.yml 中保持一致。
#
# 部署时 docker compose 会自动读取同目录下的 .env。
# nexus-server 的安全密钥也统一从这里注入（见 docker-compose-main.yml 的 environment 段）。

# MySQL root 密码（与 application-prod.yml 的 master/erp 数据源密码一致）
MYSQL_ROOT_PASSWORD=

# RabbitMQ 密码（账号 nexus 在 compose 中写死，密码在此；至少不要太简单）
RABBITMQ_DEFAULT_PASS=

# MinIO 密码（账号 minio 在 compose 中写死，密码在此；至少 8 字符）
MINIO_ROOT_PASSWORD=

# Redis 密码（与主服务器 /docker/redis/conf/redis.conf 的 requirepass 一致）
PROD_REDIS_PASSWORD=

# ===== nexus-server 安全密钥（安全修复新增，生产必填）=====

# JWT 登录令牌签名秘钥（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
# 不设置将使用仓库默认值（仅限本地开发）；更换后所有用户需重新登录
SA_TOKEN_JWT_SECRET_KEY=

# Jasypt 加密口令（生产独立口令，不要复用仓库默认值）
# 注意：必须与生产库 ai_provider 表密文的加密口令一致——生产库密文若沿用旧口令加密，
# 需先用 doc/security/JasyptRotate.java 工具轮换为该口令加密的密文
JASYPT_PASSWORD=

# MES 设备上报接口密钥（/mes/flash/report/** 免登录接口的唯一防线）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"；
# 不设置则所有设备上报直接拒绝（fail-closed），产线刷写/测试上报会中断
MES_API_KEY=

# SnailJob 调度 token（与辅助服务器 SnailJobServer 的 token 一致；不设置沿用默认值）
SNAIL_JOB_TOKEN=
