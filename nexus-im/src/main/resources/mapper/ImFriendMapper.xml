<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.im.core.mapper.ImFriendMapper">
    
    <resultMap type="com.nexus.im.core.ImFriend" id="ImFriendResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="friendUserId" column="friend_user_id"/>
        <result property="remark" column="remark"/>
        <result property="groupName" column="group_name"/>
        <result property="addTime" column="add_time"/>
        <result property="status" column="status"/>
        <result property="isTop" column="is_top"/>
        <result property="isMuted" column="is_muted"/>
        <result property="lastChatTime" column="last_chat_time"/>
    </resultMap>
    
    <sql id="selectImFriendVo">
        select id, user_id, friend_user_id, remark, group_name, add_time, status, is_top, is_muted, last_chat_time from im_friend
    </sql>
    
    <select id="selectFriendList" parameterType="Long" resultMap="ImFriendResult">
        <include refid="selectImFriendVo"/>
        where user_id = #{userId} and status = 'accepted'
        order by is_top desc, last_chat_time desc
    </select>
    
    <select id="selectFriendRelation" parameterType="map" resultMap="ImFriendResult">
        <include refid="selectImFriendVo"/>
        where user_id = #{userId} and friend_user_id = #{friendUserId}
    </select>
    
    <select id="selectFriendCount" parameterType="Long" resultType="Integer">
        select count(*) from im_friend where user_id = #{userId} and status = 'accepted'
    </select>
    
</mapper>
