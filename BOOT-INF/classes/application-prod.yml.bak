      client-secret: ${secret.justauth.gitea.client-secret}
      redirect-uri: ${justauth.address}/social-callback?source=gitea

--- # 鏀粯閰嶇疆
pay:
  alipay:
    enabled: true
    appId: ${secret.pay.alipay.app-id}
    appPrivateKey: ${secret.pay.alipay.app-private-key}
    alipayPublicKey: ${secret.pay.alipay.alipay-public-key}
    notifyUrl: http://59e5381d.r23.cpolar.top/pay/alipay/notify
    signType: RSA2
    gatewayHost: openapi-sandbox.dl.alipaydev.com
    protocol: https
  wechat:
    enabled: false
    merchantId: ${secret.pay.wechat.merchant-id}
    merchantSerialNumber: ${secret.pay.wechat.merchant-serial-number}
    apiV3Key: ${secret.pay.wechat.api-v3-key}
    privateKeyPath: classpath:cert/wechat/apiclient_key.pem
    appId: ${secret.pay.wechat.app-id}
    notifyUrl: http://your-domain/pay/wechat/notify
  sqb:
    enabled: false
    apiDomain: https://api.shouqianba.com
    terminalSn: ${secret.pay.sqb.terminal-sn}
    terminalKey: ${secret.pay.sqb.terminal-key}
    appId: ${secret.pay.sqb.app-id}
    vendorSn: ${secret.pay.sqb.vendor-sn}
    vendorKey: ${secret.pay.sqb.vendor-key}
    notifyUrl: http://your-domain/pay/sqb/notify
    publicKey: classpath:cert/sqb/public_key.pem

--- # rabbitmq 娑堟伅闃熷垪閰嶇疆
spring.rabbitmq:
  host: localhost
  port: 5672
  username: nexus
  password: nexuspw
  virtual-host: /erp
  publisher-confirm-type: correlated
  publisher-returns: true
  listener:
    simple:
      acknowledge-mode: manual
      prefetch: 10



