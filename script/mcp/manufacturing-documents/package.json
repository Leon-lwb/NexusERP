{
  "name": "nexus-manufacturing-documents-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "制造运营资料服务：只读访问三份正式业务资料的本地 MCP 服务",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check document-store.mjs && node --check server.mjs",
    "test": "node --test --test-concurrency=1 test/document-store.test.mjs test/stdio.test.mjs test/http.test.mjs",
    "test:protocol": "node --test --test-concurrency=1 test/stdio.test.mjs test/http.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
