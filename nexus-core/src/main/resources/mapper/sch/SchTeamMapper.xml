<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.core.sch.mapper.SchTeamMapper">

    <resultMap type="SchTeam" id="SchTeamResult">
        <result property="teamId" column="team_id"/>
        <result property="teamCode" column="team_code"/>
        <result property="teamName" column="team_name"/>
        <result property="teamCategory" column="team_category"/>
        <result property="workshopId" column="workshop_id"/>
        <result property="workshopName" column="workshop_name"/>
        <result property="leaderId" column="leader_id"/>
        <result property="leaderName" column="leader_name"/>
        <result property="memberCount" column="member_count"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap id="SchTeamSchTeamMemberResult" type="SchTeam" extends="SchTeamResult">
        <collection property="schTeamMemberList" ofType="SchTeamMember" column="team_id"
                    select="selectSchTeamMemberList"/>
    </resultMap>

    <resultMap type="com.nexus.core.sch.domain.SchTeamMember" id="SchTeamMemberResult">
        <result property="memberId" column="member_id"/>
        <result property="teamId" column="team_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="workerName" column="worker_name"/>
        <result property="workerCode" column="worker_code"/>
        <result property="role" column="role"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="expireDate" column="expire_date"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>

    </resultMap>

    <sql id="selectSchTeamVo">
        select team_id,
               team_code,
               team_name,
               team_category,
               workshop_id,
               workshop_name,
               leader_id,
               leader_name,
               member_count,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time
        from sch_team
    </sql>

    <select id="selectSchTeamList" parameterType="SchTeam" resultMap="SchTeamResult">
        <include refid="selectSchTeamVo"/>
        <where>
            <if test="teamCode != null  and teamCode != ''">and team_code = #{teamCode}</if>
            <if test="teamName != null  and teamName != ''">and team_name like concat('%', #{teamName}, '%')</if>
            <if test="teamCategory != null  and teamCategory != ''">and team_category = #{teamCategory}</if>
            <if test="workshopId != null ">and workshop_id = #{workshopId}</if>
            <if test="workshopName != null  and workshopName != ''">and workshop_name like concat('%', #{workshopName},
                '%')
            </if>
            <if test="leaderId != null ">and leader_id = #{leaderId}</if>
            <if test="leaderName != null  and leaderName != ''">and leader_name like concat('%', #{leaderName}, '%')
            </if>
            <if test="memberCount != null ">and member_count = #{memberCount}</if>
            <if test="status != null ">and status = #{status}</if>
        </where>
    </select>

    <select id="selectSchTeamByTeamId" parameterType="Long" resultMap="SchTeamSchTeamMemberResult">
        select team_id,
               team_code,
               team_name,
               team_category,
               workshop_id,
               workshop_name,
               leader_id,
               leader_name,
               member_count,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time
        from sch_team
        where team_id = #{teamId}
    </select>

    <select id="selectSchTeamMemberList" resultMap="SchTeamMemberResult">
        select member_id,
               team_id,
               worker_id,
               worker_name,
               worker_code,
               role,
               effective_date,
               expire_date,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time
        from sch_team_member
        where team_id = #{team_id}
    </select>

    <select id="checkTeamMemberExists" parameterType="map" resultMap="SchTeamMemberResult">
        select member_id,
               team_id,
               worker_id,
               worker_name,
               worker_code,
               role,
               effective_date,
               expire_date,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time
        from sch_team_member
        where team_id = #{teamId} and worker_id = #{workerId}
    </select>

    <insert id="insertSchTeam" parameterType="SchTeam" useGeneratedKeys="true" keyProperty="teamId">
        insert into sch_team
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamCode != null and teamCode != ''">team_code,</if>
            <if test="teamName != null and teamName != ''">team_name,</if>
            <if test="teamCategory != null">team_category,</if>
            <if test="workshopId != null">workshop_id,</if>
            <if test="workshopName != null">workshop_name,</if>
            <if test="leaderId != null">leader_id,</if>
            <if test="leaderName != null">leader_name,</if>
            <if test="memberCount != null">member_count,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamCode != null and teamCode != ''">#{teamCode},</if>
            <if test="teamName != null and teamName != ''">#{teamName},</if>
            <if test="teamCategory != null">#{teamCategory},</if>
            <if test="workshopId != null">#{workshopId},</if>
            <if test="workshopName != null">#{workshopName},</if>
            <if test="leaderId != null">#{leaderId},</if>
            <if test="leaderName != null">#{leaderName},</if>
            <if test="memberCount != null">#{memberCount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateSchTeam" parameterType="SchTeam">
        update sch_team
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamCode != null and teamCode != ''">team_code = #{teamCode},</if>
            <if test="teamName != null and teamName != ''">team_name = #{teamName},</if>
            <if test="teamCategory != null">team_category = #{teamCategory},</if>
            <if test="workshopId != null">workshop_id = #{workshopId},</if>
            <if test="workshopName != null">workshop_name = #{workshopName},</if>
            <if test="leaderId != null">leader_id = #{leaderId},</if>
            <if test="leaderName != null">leader_name = #{leaderName},</if>
            <if test="memberCount != null">member_count = #{memberCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where team_id = #{teamId}
    </update>

    <delete id="deleteSchTeamByTeamId" parameterType="Long">
        delete
        from sch_team
        where team_id = #{teamId}
    </delete>

    <delete id="deleteSchTeamByTeamIds" parameterType="String">
        delete from sch_team where team_id in
        <foreach item="teamId" collection="array" open="(" separator="," close=")">
            #{teamId}
        </foreach>
    </delete>

    <delete id="deleteSchTeamMemberByTeamIds" parameterType="String">
        delete from sch_team_member where team_id in
        <foreach item="teamId" collection="array" open="(" separator="," close=")">
            #{teamId}
        </foreach>
    </delete>

    <delete id="deleteSchTeamMemberByTeamId" parameterType="Long">
        delete
        from sch_team_member
        where team_id = #{teamId}
    </delete>

    <insert id="batchSchTeamMember">
        insert into sch_team_member( member_id, team_id, worker_id, worker_name, worker_code, role, effective_date,
        expire_date, status, remark, create_by, create_time, update_by, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.memberId}, #{item.teamId}, #{item.workerId}, #{item.workerName}, #{item.workerCode}, #{item.role},
            #{item.effectiveDate}, #{item.expireDate}, #{item.status}, #{item.remark}, #{item.createBy},
            #{item.createTime}, #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>

</mapper>