                        <if test="earlyLeaveThreshold != null "> and early_leave_threshold = #{earlyLeaveThreshold}</if>
                        <if test="absentThreshold != null "> and absent_threshold = #{absentThreshold}</if>
                        <if test="isEnabled != null "> and is_enabled = #{isEnabled}</if>
        </where>
    </select>

    <select id="selectSchPunchRuleByRuleId" parameterType="Long" resultMap="SchPunchRuleResult">
