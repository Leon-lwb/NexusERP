    <sql id="selectSchPunchRuleVo">
        select rule_id, rule_name, shift_id, shift_name, work_start_time, work_end_time, allow_clock_in_start, allow_clock_in_end, allow_clock_out_start, allow_clock_out_end, location_lat, location_lng, location_radius, location_address, allow_wifi_ssids, allow_bluetooth_devices, allow_outdoor_punch, outdoor_require_photo, allow_supplement, supplement_deadline, late_threshold, early_leave_threshold, absent_threshold, is_enabled, remark, create_by, create_time, update_by, update_time from sch_punch_rule
