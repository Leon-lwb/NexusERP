                        <if test="allowWifiSsids != null  and allowWifiSsids != ''"> and allow_wifi_ssids = #{allowWifiSsids}</if>
                        <if test="allowBluetoothDevices != null  and allowBluetoothDevices != ''"> and allow_bluetooth_devices = #{allowBluetoothDevices}</if>
                        <if test="allowOutdoorPunch != null "> and allow_outdoor_punch = #{allowOutdoorPunch}</if>
                        <if test="outdoorRequirePhoto != null "> and outdoor_require_photo = #{outdoorRequirePhoto}</if>
                        <if test="allowSupplement != null "> and allow_supplement = #{allowSupplement}</if>
