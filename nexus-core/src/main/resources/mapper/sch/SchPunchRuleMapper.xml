    <select id="selectSchPunchRuleList" parameterType="SchPunchRule" resultMap="SchPunchRuleResult">
        <include refid="selectSchPunchRuleVo"/>
        <where>
                        <if test="ruleName != null  and ruleName != ''"> and rule_name like concat('%', #{ruleName}, '%')</if>
                        <if test="shiftId != null "> and shift_id = #{shiftId}</if>
                        <if test="shiftName != null  and shiftName != ''"> and shift_name like concat('%', #{shiftName}, '%')</if>
                        <if test="workStartTime != null "> and work_start_time = #{workStartTime}</if>
                        <if test="workEndTime != null "> and work_end_time = #{workEndTime}</if>
