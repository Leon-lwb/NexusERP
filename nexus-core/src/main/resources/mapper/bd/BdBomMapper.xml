<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.core.bd.mapper.BdBomMapper">

    <resultMap type="BdBom" id="BdBomResult">
            <result property="bomId"    column="bom_id"    />
            <result property="parentMaterialId"    column="parent_material_id"    />
            <result property="bomVersion"    column="bom_version"    />
            <result property="bomName"    column="bom_name"    />
            <result property="effectiveDate"    column="effective_date"    />
            <result property="expiryDate"    column="expiry_date"    />
            <result property="isCurrent"    column="is_current"    />
            <result property="status"    column="status"    />
            <result property="remark"    column="remark"    />
            <result property="attr1"    column="attr1"    />
            <result property="attr2"    column="attr2"    />
            <result property="attr3"    column="attr3"    />
            <result property="attr4"    column="attr4"    />
            <result property="createBy"    column="create_by"    />
            <result property="createTime"    column="create_time"    />
            <result property="updateBy"    column="update_by"    />
            <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectBdBomVo">
        select bom_id, parent_material_id, bom_version, bom_name, effective_date, expiry_date, is_current, status, remark, attr1, attr2, attr3, attr4, create_by, create_time, update_by, update_time from bd_bom
    </sql>

    <select id="selectBdBomList" parameterType="BdBom" resultMap="BdBomResult">
        <include refid="selectBdBomVo"/>
        <where>
                        <if test="bomId != null"> and bom_id = #{bomId}</if>
                        <if test="parentMaterialId != null"> and parent_material_id = #{parentMaterialId}</if>
                        <if test="bomName != null  and bomName != ''"> and bom_name like concat('%', #{bomName}, '%')</if>
                        <if test="effectiveDate != null "> and effective_date = #{effectiveDate}</if>
                        <if test="expiryDate != null "> and expiry_date = #{expiryDate}</if>
                        <if test="isCurrent != null "> and is_current = #{isCurrent}</if>
                        <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="selectBdBomByBomId" parameterType="Long" resultMap="BdBomResult">
            <include refid="selectBdBomVo"/>
            where bom_id = #{bomId}
    </select>

    <insert id="insertBdBom" parameterType="BdBom" useGeneratedKeys="true" keyProperty="bomId">
        insert into bd_bom
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="parentMaterialId != null">parent_material_id,</if>
                    <if test="bomVersion != null and bomVersion != ''">bom_version,</if>
                    <if test="bomName != null and bomName != ''">bom_name,</if>
                    <if test="effectiveDate != null">effective_date,</if>
                    <if test="expiryDate != null">expiry_date,</if>
                    <if test="isCurrent != null">is_current,</if>
                    <if test="status != null">status,</if>
                    <if test="remark != null">remark,</if>
                    <if test="attr1 != null">attr1,</if>
                    <if test="attr2 != null">attr2,</if>
                    <if test="attr3 != null">attr3,</if>
                    <if test="attr4 != null">attr4,</if>
                    <if test="createBy != null">create_by,</if>
                    <if test="createTime != null">create_time,</if>
                    <if test="updateBy != null">update_by,</if>
                    <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                    <if test="parentMaterialId != null">#{parentMaterialId},</if>
                    <if test="bomVersion != null and bomVersion != ''">#{bomVersion},</if>
                    <if test="bomName != null and bomName != ''">#{bomName},</if>
                    <if test="effectiveDate != null">#{effectiveDate},</if>
                    <if test="expiryDate != null">#{expiryDate},</if>
                    <if test="isCurrent != null">#{isCurrent},</if>
                    <if test="status != null">#{status},</if>
                    <if test="remark != null">#{remark},</if>
                    <if test="attr1 != null">#{attr1},</if>
                    <if test="attr2 != null">#{attr2},</if>
                    <if test="attr3 != null">#{attr3},</if>
                    <if test="attr4 != null">#{attr4},</if>
                    <if test="createBy != null">#{createBy},</if>
                    <if test="createTime != null">#{createTime},</if>
                    <if test="updateBy != null">#{updateBy},</if>
                    <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateBdBom" parameterType="BdBom">
        update bd_bom
        <trim prefix="SET" suffixOverrides=",">
                    <if test="parentMaterialId != null">parent_material_id = #{parentMaterialId},</if>
                    <if test="bomVersion != null and bomVersion != ''">bom_version = #{bomVersion},</if>
                    <if test="bomName != null and bomName != ''">bom_name = #{bomName},</if>
                    <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
                    <if test="expiryDate != null">expiry_date = #{expiryDate},</if>
                    <if test="isCurrent != null">is_current = #{isCurrent},</if>
                    <if test="status != null">status = #{status},</if>
                    <if test="remark != null">remark = #{remark},</if>
                    <if test="attr1 != null">attr1 = #{attr1},</if>
                    <if test="attr2 != null">attr2 = #{attr2},</if>
                    <if test="attr3 != null">attr3 = #{attr3},</if>
                    <if test="attr4 != null">attr4 = #{attr4},</if>
                    <if test="createBy != null">create_by = #{createBy},</if>
                    <if test="createTime != null">create_time = #{createTime},</if>
                    <if test="updateBy != null">update_by = #{updateBy},</if>
                    <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where bom_id = #{bomId}
    </update>

    <delete id="deleteBdBomByBomId" parameterType="Long">
        delete from bd_bom where bom_id = #{bomId}
    </delete>

    <delete id="deleteBdBomByBomIds" parameterType="String">
        delete from bd_bom where bom_id in
        <foreach item="bomId" collection="array" open="(" separator="," close=")">
            #{bomId}
        </foreach>
    </delete>
    
    <insert id="insertBomDetail" parameterType="com.nexus.core.bd.domain.dto.BomDetailDTO">
        insert into bd_bom_detail (
            bom_id,
            child_material_id,
            quantity_per_parent,
            loss_rate,
            operation_step,
            workstation_id,
            lead_time,
            effective_date,
            expiry_date,
            sort_order,
            status,
            remark,
            create_by,
            create_time
        ) values (
            #{bomId},
            #{childMaterialId},
            #{quantityPerParent},
            #{lossRate},
            #{operationStep},
            #{workstationId},
            #{leadTime},
            #{effectiveDate},
            #{expiryDate},
            #{sortOrder},
            #{status},
            #{remark},
            #{createBy},
            sysdate()
        )
    </insert>
    
    <update id="updateBomDetail" parameterType="com.nexus.core.bd.domain.dto.BomDetailDTO">
        update bd_bom_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="bomId != null">bom_id = #{bomId},</if>
            <if test="childMaterialId != null">child_material_id = #{childMaterialId},</if>
            <if test="quantityPerParent != null">quantity_per_parent = #{quantityPerParent},</if>
            <if test="lossRate != null">loss_rate = #{lossRate},</if>
            <if test="operationStep != null">operation_step = #{operationStep},</if>
            <if test="workstationId != null">workstation_id = #{workstationId},</if>
            <if test="leadTime != null">lead_time = #{leadTime},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="expiryDate != null">expiry_date = #{expiryDate},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </trim>
        where detail_id = #{detailId}
    </update>
    
    <select id="selectBomDetailByDetailId" parameterType="Long" resultType="String">
        SELECT CONCAT(
            '明细ID: ', detail_id,
            ', BOM ID: ', bom_id,
            ', 子项物料ID: ', child_material_id,
            ', 用量: ', quantity_per_parent,
            ', 损耗率: ', IFNULL(loss_rate, 0),
            ', 工序步骤: ', IFNULL(operation_step, '无'),
            ', 工作中心ID: ', IFNULL(workstation_id, '无'),
            ', 提前期: ', IFNULL(lead_time, 0),
            ', 状态: ', IFNULL(status, 1)
        ) AS detail_info
        FROM bd_bom_detail
        WHERE detail_id = #{detailId}
    </select>
    
    <resultMap type="com.nexus.core.bd.domain.vo.BomDetailVO" id="BomDetailResult">
        <result property="detailId"    column="detail_id"    />
        <result property="bomId"    column="bom_id"    />
        <result property="parentMaterialId"    column="parent_material_id"    />
        <result property="parentMaterialCode"    column="parent_material_code"    />
        <result property="parentMaterialName"    column="parent_material_name"    />
        <result property="childMaterialId"    column="child_material_id"    />
        <result property="childMaterialCode"    column="child_material_code"    />
        <result property="childMaterialName"    column="child_material_name"    />
        <result property="childMaterialSpec"    column="child_material_spec"    />
        <result property="baseUomId"    column="base_uom_id"    />
        <result property="baseUomName"    column="base_uom_name"    />
        <result property="quantityPerParent"    column="quantity_per_parent"    />
        <result property="lossRate"    column="loss_rate"    />
        <result property="totalQuantity"    column="total_quantity"    />
        <result property="operationStep"    column="operation_step"    />
        <result property="workstationId"    column="workstation_id"    />
        <result property="workstationName"    column="workstation_name"    />
        <result property="leadTime"    column="lead_time"    />
        <result property="effectiveDate"    column="effective_date"    />
        <result property="expiryDate"    column="expiry_date"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"    column="status"    />
        <result property="statusDesc"    column="status_desc"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>
    
    <select id="selectBomDetailList" parameterType="Long" resultMap="BomDetailResult">
        SELECT 
            d.detail_id,
            d.bom_id,
            d.child_material_id,
            m.material_code AS child_material_code,
            m.material_name AS child_material_name,
            m.material_spec AS child_material_spec,
            m.base_uom_id,
            u.uom_name AS base_uom_name,
            d.quantity_per_parent,
            d.loss_rate,
            (d.quantity_per_parent * (1 + IFNULL(d.loss_rate, 0) / 100)) AS total_quantity,
            d.operation_step,
            d.workstation_id,
            d.lead_time,
            d.effective_date,
            d.expiry_date,
            d.sort_order,
            d.status,
            CASE 
                WHEN d.status = 1 THEN '启用'
                WHEN d.status = 0 THEN '停用'
                ELSE '未知'
            END AS status_desc,
            d.remark,
            d.create_by,
            d.create_time,
            d.update_by,
            d.update_time
        FROM bd_bom_detail d
        LEFT JOIN bd_material m ON d.child_material_id = m.material_id
        LEFT JOIN bd_unit_of_measure u ON m.base_uom_id = u.uom_id
        WHERE d.bom_id = #{bomId}
        ORDER BY d.sort_order
    </select>
    
    <delete id="deleteBomDetails" parameterType="Long">
        DELETE FROM bd_bom_detail WHERE detail_id IN
        <foreach item="detailId" collection="array" open="(" separator="," close=")">
            #{detailId}
        </foreach>
    </delete>
</mapper>