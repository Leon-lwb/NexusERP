<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.bd.mapper.BdClientMapper">

    <resultMap type="BdClient" id="BdClientResult">
            <result property="clientId"    column="client_id"    />
            <result property="clientCode"    column="client_code"    />
            <result property="clientName"    column="client_name"    />
            <result property="clientNick"    column="client_nick"    />
            <result property="clientEn"    column="client_en"    />
            <result property="clientDesc"    column="client_desc"    />
            <result property="clientType"    column="client_type"    />
            <result property="clientLogo"    column="client_logo"    />
            <result property="address"    column="address"    />
            <result property="webSite"    column="web_site"    />
            <result property="email"    column="email"    />
            <result property="tel"    column="tel"    />
            <result property="contact1"    column="contact1"    />
            <result property="contact1Tel"    column="contact1_tel"    />
            <result property="contact1Emal"    column="contact1_emal"    />
            <result property="contact2"    column="contact2"    />
            <result property="contact2Tel"    column="contact2_tel"    />
            <result property="contact2Emal"    column="contact2_emal"    />
            <result property="creditCode"    column="credit_code"    />
            <result property="remark"    column="remark"    />
            <result property="attr1"    column="attr1"    />
            <result property="attr2"    column="attr2"    />
            <result property="attr3"    column="attr3"    />
            <result property="attr4"    column="attr4"    />
            <result property="createBy"    column="create_by"    />
            <result property="createTime"    column="create_time"    />
            <result property="updateBy"    column="update_by"    />
            <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectBdClientVo">
        select client_id, client_code, client_name, client_nick, client_en, client_desc, client_type, client_logo, address, web_site, email, tel, contact1, contact1_tel, contact1_emal, contact2, contact2_tel, contact2_emal, credit_code, remark, attr1, attr2, attr3, attr4, create_by, create_time, update_by, update_time from bd_client
    </sql>

    <select id="selectBdClientList" parameterType="BdClient" resultMap="BdClientResult">
        <include refid="selectBdClientVo"/>
        <where>
                        <if test="clientCode != null  and clientCode != ''"> and client_code = #{clientCode}</if>
                        <if test="clientName != null  and clientName != ''"> and client_name like concat('%', #{clientName}, '%')</if>
                        <if test="clientEn != null  and clientEn != ''"> and client_en = #{clientEn}</if>
                        <if test="clientType != null  and clientType != ''"> and client_type = #{clientType}</if>
                        <if test="tel != null  and tel != ''"> and tel = #{tel}</if>
                        <if test="creditCode != null  and creditCode != ''"> and credit_code = #{creditCode}</if>
        </where>
    </select>

    <select id="selectBdClientByClientId" parameterType="Long" resultMap="BdClientResult">
            <include refid="selectBdClientVo"/>
            where client_id = #{clientId}
    </select>

    <insert id="insertBdClient" parameterType="BdClient">
        insert into bd_client
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="clientId != null">client_id,</if>
                    <if test="clientCode != null and clientCode != ''">client_code,</if>
                    <if test="clientName != null and clientName != ''">client_name,</if>
                    <if test="clientNick != null">client_nick,</if>
                    <if test="clientEn != null">client_en,</if>
                    <if test="clientDesc != null and clientDesc != ''">client_desc,</if>
                    <if test="clientType != null and clientType != ''">client_type,</if>
                    <if test="clientLogo != null">client_logo,</if>
                    <if test="address != null and address != ''">address,</if>
                    <if test="webSite != null">web_site,</if>
                    <if test="email != null and email != ''">email,</if>
                    <if test="tel != null and tel != ''">tel,</if>
                    <if test="contact1 != null and contact1 != ''">contact1,</if>
                    <if test="contact1Tel != null and contact1Tel != ''">contact1_tel,</if>
                    <if test="contact1Emal != null">contact1_emal,</if>
                    <if test="contact2 != null">contact2,</if>
                    <if test="contact2Tel != null">contact2_tel,</if>
                    <if test="contact2Emal != null">contact2_emal,</if>
                    <if test="creditCode != null">credit_code,</if>
                    <if test="remark != null">remark,</if>
                    <if test="attr1 != null">attr1,</if>
                    <if test="attr2 != null">attr2,</if>
                    <if test="attr3 != null">attr3,</if>
                    <if test="attr4 != null">attr4,</if>
                    <if test="createBy != null">create_by,</if>
                    <if test="createTime != null">create_time,</if>
                    <if test="updateBy != null">update_by,</if>
                    <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                    <if test="clientId != null">#{clientId},</if>
                    <if test="clientCode != null and clientCode != ''">#{clientCode},</if>
                    <if test="clientName != null and clientName != ''">#{clientName},</if>
                    <if test="clientNick != null">#{clientNick},</if>
                    <if test="clientEn != null">#{clientEn},</if>
                    <if test="clientDesc != null and clientDesc != ''">#{clientDesc},</if>
                    <if test="clientType != null and clientType != ''">#{clientType},</if>
                    <if test="clientLogo != null">#{clientLogo},</if>
                    <if test="address != null and address != ''">#{address},</if>
                    <if test="webSite != null">#{webSite},</if>
                    <if test="email != null and email != ''">#{email},</if>
                    <if test="tel != null and tel != ''">#{tel},</if>
                    <if test="contact1 != null and contact1 != ''">#{contact1},</if>
                    <if test="contact1Tel != null and contact1Tel != ''">#{contact1Tel},</if>
                    <if test="contact1Emal != null">#{contact1Emal},</if>
                    <if test="contact2 != null">#{contact2},</if>
                    <if test="contact2Tel != null">#{contact2Tel},</if>
                    <if test="contact2Emal != null">#{contact2Emal},</if>
                    <if test="creditCode != null">#{creditCode},</if>
                    <if test="remark != null">#{remark},</if>
                    <if test="attr1 != null">#{attr1},</if>
                    <if test="attr2 != null">#{attr2},</if>
                    <if test="attr3 != null">#{attr3},</if>
                    <if test="attr4 != null">#{attr4},</if>
                    <if test="createBy != null">#{createBy},</if>
                    <if test="createTime != null">#{createTime},</if>
                    <if test="updateBy != null">#{updateBy},</if>
                    <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateBdClient" parameterType="BdClient">
        update bd_client
        <trim prefix="SET" suffixOverrides=",">
                    <if test="clientCode != null and clientCode != ''">client_code = #{clientCode},</if>
                    <if test="clientName != null and clientName != ''">client_name = #{clientName},</if>
                    <if test="clientNick != null">client_nick = #{clientNick},</if>
                    <if test="clientEn != null">client_en = #{clientEn},</if>
                    <if test="clientDesc != null and clientDesc != ''">client_desc = #{clientDesc},</if>
                    <if test="clientType != null and clientType != ''">client_type = #{clientType},</if>
                    <if test="clientLogo != null">client_logo = #{clientLogo},</if>
                    <if test="address != null and address != ''">address = #{address},</if>
                    <if test="webSite != null">web_site = #{webSite},</if>
                    <if test="email != null and email != ''">email = #{email},</if>
                    <if test="tel != null and tel != ''">tel = #{tel},</if>
                    <if test="contact1 != null and contact1 != ''">contact1 = #{contact1},</if>
                    <if test="contact1Tel != null and contact1Tel != ''">contact1_tel = #{contact1Tel},</if>
                    <if test="contact1Emal != null">contact1_emal = #{contact1Emal},</if>
                    <if test="contact2 != null">contact2 = #{contact2},</if>
                    <if test="contact2Tel != null">contact2_tel = #{contact2Tel},</if>
                    <if test="contact2Emal != null">contact2_emal = #{contact2Emal},</if>
                    <if test="creditCode != null">credit_code = #{creditCode},</if>
                    <if test="remark != null">remark = #{remark},</if>
                    <if test="attr1 != null">attr1 = #{attr1},</if>
                    <if test="attr2 != null">attr2 = #{attr2},</if>
                    <if test="attr3 != null">attr3 = #{attr3},</if>
                    <if test="attr4 != null">attr4 = #{attr4},</if>
                    <if test="createBy != null">create_by = #{createBy},</if>
                    <if test="createTime != null">create_time = #{createTime},</if>
                    <if test="updateBy != null">update_by = #{updateBy},</if>
                    <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where client_id = #{clientId}
    </update>

    <delete id="deleteBdClientByClientId" parameterType="Long">
        delete from bd_client where client_id = #{clientId}
    </delete>

    <delete id="deleteBdClientByClientIds" parameterType="String">
        delete from bd_client where client_id in
        <foreach item="clientId" collection="array" open="(" separator="," close=")">
            #{clientId}
        </foreach>
    </delete>
</mapper>