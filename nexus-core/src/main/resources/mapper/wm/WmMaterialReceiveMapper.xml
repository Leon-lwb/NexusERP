    <delete id="deleteWmMaterialReceiveByReceiveId" parameterType="Long">
        delete
        from wm_material_receive
        where receive_id = #{receiveId}
    </delete>

    <delete id="deleteWmMaterialReceiveByReceiveIds" parameterType="String">
        delete from wm_material_receive where receive_id in
        <foreach item="receiveId" collection="array" open="(" separator="," close=")">
            #{receiveId}
        </foreach>
    </delete>

    <delete id="deleteWmMaterialReceiveLineByReceiveIds" parameterType="String">
        delete from wm_material_receive_line where receive_id in
        <foreach item="receiveId" collection="array" open="(" separator="," close=")">
            #{receiveId}
        </foreach>
    </delete>

    <delete id="deleteWmMaterialReceiveLineByReceiveId" parameterType="Long">
        delete
        from wm_material_receive_line
        where receive_id = #{receiveId}
    </delete>

    <insert id="batchWmMaterialReceiveLine">
        insert into wm_material_receive_line( line_id, receive_id, source_doc_line_id, material_id, material_code,
        material_name, material_spec, base_uom_id, base_uom_name, quantity_received, batch_id, batch_code, warehouse_id,
        warehouse_code, warehouse_name, area_id, area_code, area_name, location_id, location_code, location_name,
        remark, attr1, attr2, attr3, attr4, create_by, create_time, update_by, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.receiveId}, #{item.sourceDocLineId}, #{item.materialId}, #{item.materialCode},
            #{item.materialName}, #{item.materialSpec}, #{item.baseUomId}, #{item.baseUomName},
            #{item.quantityReceived}, #{item.batchId}, #{item.batchCode}, #{item.warehouseId}, #{item.warehouseCode},
            #{item.warehouseName}, #{item.areaId}, #{item.areaCode}, #{item.areaName}, #{item.locationId},
            #{item.locationCode}, #{item.locationName}, #{item.remark}, #{item.attr1}, #{item.attr2}, #{item.attr3},
            #{item.attr4}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>
