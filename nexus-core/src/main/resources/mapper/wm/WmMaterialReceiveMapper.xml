    </select>

    <select id="selectWmMaterialReceiveDetailListByLineId" resultMap="com.nexus.core.wm.mapper.WmMaterialReceiveDetailMapper.WmMaterialReceiveDetailResult">
        select detail_id, line_id, receive_id, material_id, material_code, material_name, material_spec, base_uom_id, base_uom_name, quantity, batch_id, batch_code, warehouse_id, warehouse_code, warehouse_name, area_id, area_code, area_name, location_id, location_code, location_name, remark, attr1, attr2, attr3, attr4, create_by, create_time, update_by, update_time from wm_material_receive_detail
        where line_id = #{line_id}
