<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.core.prd.mapper.PrdWorkOrderResourceMapper">

    <resultMap type="com.nexus.core.prd.domain.PrdWorkOrderResource" id="PrdWorkOrderResourceResult">
        <id property="id" column="id"/>
        <result property="woId" column="wo_id"/>
        <result property="resourceType" column="resource_type"/>
        <result property="resourceId" column="resource_id"/>
        <result property="resourceCode" column="resource_code"/>
        <result property="resourceName" column="resource_name"/>
        <result property="seq" column="seq"/>
        <result property="parentId" column="parent_id"/>
        <result property="parentType" column="parent_type"/>
        <result property="planStartTime" column="plan_start_time"/>
        <result property="planEndTime" column="plan_end_time"/>
        <result property="actualStartTime" column="actual_start_time"/>
        <result property="actualEndTime" column="actual_end_time"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="selectPrdWorkOrderResourceVo">
        select id,
               wo_id,
               resource_type,
               resource_id,
               resource_code,
               resource_name,
               seq,
               parent_id,
               parent_type,
               plan_start_time,
               plan_end_time,
               actual_start_time,
               actual_end_time,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time,
               deleted
        from prd_work_order_resource
    </sql>

    <select id="selectPrdWorkOrderResourceList" parameterType="com.nexus.core.prd.domain.PrdWorkOrderResource"
            resultMap="PrdWorkOrderResourceResult">
        <include refid="selectPrdWorkOrderResourceVo"/>
        where deleted = 0
        <if test="woId != null">
            and wo_id = #{woId}
        </if>
        <if test="resourceType != null and resourceType != ''">
            and resource_type = #{resourceType}
        </if>
        <if test="resourceId != null">
            and resource_id = #{resourceId}
        </if>
        <if test="resourceCode != null and resourceCode != ''">
            and resource_code like concat('%', #{resourceCode}, '%')
        </if>
        <if test="resourceName != null and resourceName != ''">
            and resource_name like concat('%', #{resourceName}, '%')
        </if>
        <if test="parentId != null">
            and parent_id = #{parentId}
        </if>
        <if test="parentType != null and parentType != ''">
            and parent_type = #{parentType}
        </if>
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        order by seq asc, create_time asc
    </select>

    <select id="selectByWoId" resultMap="PrdWorkOrderResourceResult">
        <include refid="selectPrdWorkOrderResourceVo"/>
        where wo_id = #{woId} and deleted = 0
        order by seq asc, create_time asc
    </select>

    <select id="selectByWoIdAndType" resultMap="PrdWorkOrderResourceResult">
        <include refid="selectPrdWorkOrderResourceVo"/>
        where wo_id = #{woId} and resource_type = #{resourceType} and deleted = 0
        order by seq asc, create_time asc
    </select>

    <delete id="deletePrdWorkOrderResourceByIds">
        update prd_work_order_resource
        set deleted = 1
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteByWoId">
        delete from prd_work_order_resource
        where wo_id = #{woId}
    </delete>

    <delete id="deleteByWoIdAndType">
        delete from prd_work_order_resource
        where wo_id = #{woId} and resource_type = #{resourceType}
    </delete>

</mapper>
