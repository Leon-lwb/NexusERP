<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.nexus</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-im</artifactId>

    <description>站内通知与即时通讯(IM)</description>

    <dependencies>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- P3-1: 测试依赖（test scope，不打入生产包） -->
        <!-- spring-boot-starter-test 已包含 JUnit 5 + Mockito 5（内置 inline mock maker，支持 mockStatic） + AssertJ + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除 JUnit Vintage，只用 JUnit 5 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <properties>
        <!-- P3-9: 默认排除 @Tag("integration") 标记的集成测试（需要完整 Spring 上下文 + DB + Redis）。
             CI 单独 job 触发集成测试：mvn test -Dim.excludedGroups= -Dgroups=integration -->
        <im.excludedGroups>integration</im.excludedGroups>
        <!-- P3-9: 默认不限制 include tags（执行所有非 excluded 的测试）。
             CI 集成测试 job：mvn test -Dim.excludedGroups= -Dgroups=integration -->
        <im.groups></im.groups>
        <!-- P3-10: jacoco prepare-agent 注入的 javaagent 参数会写入此 property。
             surefire argLine 必须引用 ${argLine} 才能让 jacoco 接管字节码插桩。
             默认空字符串保证不启用 jacoco 时 surefire 仍可正常运行。 -->
        <argLine>-Dfile.encoding=UTF-8</argLine>
        <!-- P3-10: jacoco 覆盖率门槛（初始 50%，稳定后提升至 70%）。
             通过 -Dim.jacoco.haltOnFailure=false 可在本地临时绕过。 -->
        <im.jacoco.haltOnFailure>false</im.jacoco.haltOnFailure>
        <im.jacoco.lineRatio>0.50</im.jacoco.lineRatio>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <build>
        <plugins>
            <!-- P3-1: 覆盖根 pom 的 surefire 配置。
                 根 pom 默认 <groups>${profiles.active}</groups> 限制只执行带 @Tag("dev"/"local"/"prod") 的测试，
                 本模块的回归测试需要在所有 profile 下执行，故覆盖为空 groups（=全部执行），
                 并将 @Tag("integration") 标记的集成测试排除在默认构建之外。
                 P3-9: 改为 property 占位符，CI 可通过 -Dim.excludedGroups= -Dim.groups=integration 触发集成测试。
                 P3-10: argLine 引用 ${argLine} property 让 jacoco prepare-agent 注入 javaagent。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                    <groups combine.self="override">${im.groups}</groups>
                    <excludedGroups combine.self="override">${im.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- P3-10: JaCoCo 覆盖率插件。
                 - prepare-agent: 在 initialize 阶段将 javaagent 参数写入 ${argLine} property，供 surefire 使用
                 - report: 在 verify 阶段生成 target/site/jacoco/index.html + jacoco.xml（CI 上传用）
                 - check: 在 verify 阶段执行覆盖率门槛校验，默认 haltOnFailure=false（仅警告），
                   CI 可通过 -Dim.jacoco.haltOnFailure=true 强制失败，分阶段提升至 70% 后再开启。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>${im.jacoco.haltOnFailure}</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <includes>
                                        <include>com.nexus.im.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${im.jacoco.lineRatio}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
