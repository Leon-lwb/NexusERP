<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.nexus</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-station</artifactId>

    <description>
        工位终端设备通道模块（nexus-station 工位机专用）：扫工号上岗、过站校验/报工、
        综测上报、关键件绑定、安灯呼叫、设备心跳等 X-API-KEY 免登录接口
    </description>

    <dependencies>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- 系统用户(上岗校验第二步: 按工人档案关联账号查 sys_user) -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- 复用 MES 业务逻辑: 安灯 callAndon/流转卡工序状态机/SN 管理(Nexus 决策: 放弃物理独立) -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-mes</artifactId>
        </dependency>

        <!-- 单元测试（test scope，不打入生产包；对齐 ruoyi-mes 配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除 JUnit Vintage，只用 JUnit 5 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <properties>
        <!-- 覆盖根 pom 的 groups 过滤(根 pom 按 profiles.active 限制只执行带 @Tag 的测试,
             导致无 @Tag 测试不执行)，覆盖为空=全部执行 -->
        <station.groups></station.groups>
        <station.excludedGroups>integration</station.excludedGroups>
        <argLine>-Dfile.encoding=UTF-8</argLine>
    </properties>

    <build>
        <plugins>
            <!-- 覆盖根 pom surefire 配置，使无 @Tag 测试在所有 profile 下执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8 -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                    <groups combine.self="override">${station.groups}</groups>
                    <excludedGroups combine.self="override">${station.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
