<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.workflow.mapper.WfDeployFormMapper">

    <select id="selectSysDeployFormByFormId" parameterType="String" resultType="com.nexus.workflow.domain.WfDeployForm">
        select * from wf_deploy_form
        where form_key = #{formKey}
    </select>

</mapper>
