<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.workflow.mapper.WfCopyMapper">

    <update id="updateState">
        update wf_copy
        set state = '已读'
            WHERE copy_id=#{id}
    </update>

</mapper>
