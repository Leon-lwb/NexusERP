<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.erp.prd.mapper.PrdCapacityCalendarMapper">

    <resultMap type="com.nexus.erp.prd.domain.vo.PrdCapacityCalendarVo" id="PrdCapacityCalendarResult">
        <id property="calendarId" column="calendar_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="calendarDate" column="calendar_date"/>
        <result property="objectType" column="object_type"/>
        <result property="objectId" column="object_id"/>
        <result property="objectCode" column="object_code"/>
        <result property="objectName" column="object_name"/>
        <result property="shiftId" column="shift_id"/>
        <result property="shiftCode" column="shift_code"/>
        <result property="shiftName" column="shift_name"/>
        <result property="availableHours" column="available_hours"/>
        <result property="plannedHours" column="planned_hours"/>
        <result property="actualHours" column="actual_hours"/>
        <result property="efficiency" column="efficiency"/>
        <result property="effectiveHours" column="effective_hours"/>
        <result property="remainingHours" column="remaining_hours"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectAvailableCapacity" resultMap="PrdCapacityCalendarResult">
        SELECT * FROM prd_capacity_calendar
        WHERE del_flag = '0'
        <if test="objectType != null and objectType != ''">
            AND object_type = #{objectType}
        </if>
        <if test="objectId != null">
            AND object_id = #{objectId}
        </if>
        <if test="startDate != null">
            AND calendar_date >= #{startDate}
        </if>
        <if test="endDate != null">
            AND calendar_date &lt;= #{endDate}
        </if>
        AND status = 'ACTIVE'
        AND remaining_hours > 0
        ORDER BY calendar_date ASC, shift_id ASC
    </select>

</mapper>
