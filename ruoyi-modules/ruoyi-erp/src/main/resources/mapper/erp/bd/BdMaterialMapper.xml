<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.erp.bd.mapper.BdMaterialMapper">

    <select id="selectByCategoryIds" resultType="com.nexus.erp.bd.domain.vo.BdMaterialVo">
        SELECT * FROM bd_material
        WHERE del_flag = '0'
        AND category_id IN
        <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </select>

</mapper>
