<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.nexus</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-system</artifactId>

    <description>
        system系统模块
    </description>

    <dependencies>
        <!-- 工程身份与私有归档端口，不依赖 AI 业务模块。 -->
        <dependency><groupId>com.nexus</groupId><artifactId>ruoyi-common-ai</artifactId></dependency>
        <!-- 进程内 premain 见证 API；仅依赖不会启用 agent，也不会赋予证明能力。 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>runtime-attestation-agent</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-translation</artifactId>
        </dependency>

        <!-- OSS功能模块 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-oss</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- excel-->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-excel</artifactId>
        </dependency>

        <!-- SMS功能模块 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sms</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sensitive</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-encrypt</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sse</artifactId>
        </dependency>

        <!-- 二级认证 SPI: 实现密码签署凭证校验器 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sign</artifactId>
        </dependency>

        <!-- 测试依赖（test scope，不打入生产包） -->
        <!-- spring-boot-starter-test 已包含 JUnit 5 + Mockito 5（内置 inline mock maker，支持 mockStatic） + AssertJ + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除 JUnit Vintage，只用 JUnit 5 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency><groupId>com.nexus</groupId><artifactId>ruoyi-common-report</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.3.232</version><scope>test</scope></dependency>
    </dependencies>

    <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><argLine>-Dfile.encoding=UTF-8 -Djdk.attach.allowAttachSelf=true</argLine></configuration>
    </plugin></plugins></build>
</project>
