<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.nexus</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ai</artifactId>

    <description>
        AI 模块 - 智能对话、数据查询、报表生成
    </description>

    <dependencies>

        <!-- AI 公共模块 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-ai</artifactId>
        </dependency>

        <!-- 复用服务端业务授权与固定实体目录。 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-report</artifactId>
        </dependency>

        <!-- 共享流程节点运行时间线类型，不引入 ruoyi-flow 运行时依赖。 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-flow</artifactId>
        </dependency>

        <!-- SSE 推送 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sse</artifactId>
        </dependency>

        <!-- 脱敏 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sensitive</artifactId>
        </dependency>

        <!-- 幂等 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- 网页接口依赖。 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- 接口文档 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <!-- ========== LangChain4j 核心 ========== -->

        <!-- OpenAI 兼容接口（DeepSeek/通义千问/OpenAI 均走此接口；含 Responses 协议模型类） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Anthropic 消息 协议（/v1/messages，OpenCode Go 等 Anthropic 兼容端点同用） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-anthropic</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Gemini generateContent 协议 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-google-ai-gemini</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Ollama 本地模型 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Agent 框架（SupervisorAgent 等） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-agentic</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- MCP 客户端（远程 HTTP/SSE + 本地 STDIO 工具接入） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- 阿里云 DashScope（通义千问） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- 智谱 AI（GLM） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-zhipu-ai</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- JDBC（ErpQueryService 需要 JdbcTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ========== RAG 知识库 ========== -->

        <!-- Apache Tika 文档解析 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-tika</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- Milvus 向量数据库 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
            <version>${langchain4j.community.version}</version>
        </dependency>

        <!-- Jsoup（联网搜索 crawlWebpage 网页正文抽取） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- OSS 文件存储（知识库文档上传） -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-oss</artifactId>
        </dependency>

        

        <!-- 本地缓存（模型实例、会话记忆、向量存储等有界缓存） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 仅供SQL租户隔离的真实结果集回归，不进入运行时依赖。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>

        <!-- 测试依赖（测试作用域，不打入生产包；参照 ruoyi-im 模式） -->
        <!-- spring-boot-starter-test 已包含 JUnit 5 + Mockito 5 + AssertJ + Spring 测试支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除 JUnit 旧版本测试引擎，只用 JUnit 5 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        

        

        

        <!-- 隔离MySQL5.7治理集成测试，不进入生产依赖。 -->
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><version>9.7.0</version><scope>test</scope></dependency>
    </dependencies>

    <properties>
        <!-- P1-6: 覆盖根 pom 的 Surefire 测试执行 配置，使无 @Tag 测试在所有环境配置 下执行（参照 ruoyi-mes P0-7 修复） -->
        <ai.groups></ai.groups>
        <ai.excludedGroups></ai.excludedGroups>
    </properties>

    <build>
        <plugins>
            <!-- P1-6: 覆盖根 pom 的 Surefire 测试执行 @Tag 过滤（根 pom 的 groups=${profiles.active} 会导致无 @Tag 测试从不执行） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Djdk.attach.allowAttachSelf=true</argLine>
                    <groups combine.self="override">${ai.groups}</groups>
                    <excludedGroups combine.self="override">${ai.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
