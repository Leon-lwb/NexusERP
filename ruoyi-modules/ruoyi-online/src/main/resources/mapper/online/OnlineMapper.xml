<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.online.mapper.OnlineMapper">

    <update id="dynamicUpdate" parameterType="java.util.Map">
        UPDATE ${tableName}
        <set>
            <foreach collection="data" item="item" index="key" open="" separator="," close="">
                ${key} = #{item}
            </foreach>
        </set>
        <where>
            <foreach collection="condition" item="item" index="key" open="" separator=" AND " close="">
                ${key} = #{item}
            </foreach>
        </where>
    </update>

    <insert id="insertDynamic" parameterType="map">
        <selectKey keyProperty="data.id" resultType="java.lang.Long" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
        INSERT INTO ${tableName}
        <foreach collection="data" item="value" index="key" open="(" separator="," close=")">
            ${key}
        </foreach>
        VALUES
        <foreach collection="data" item="value" index="key" open="(" separator="," close=")">
            #{value}
        </foreach>
    </insert>

    <delete id="deleteDynamicTable">
        DELETE FROM ${tableName}
        WHERE ${pkColumn} IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="dynamicDelete">
        DELETE FROM ${tableName}
        <where>
            <foreach collection="where" index="column" item="value">
                <choose>
                    <when test="value instanceof java.util.Collection">
                        AND ${column} IN
                        <foreach collection="value" item="item" open="(" close=")" separator=",">
                            #{item}
                        </foreach>
                    </when>
                    <otherwise>
                        AND ${column} = #{value}
                    </otherwise>
                </choose>
            </foreach>
        </where>
    </delete>

    <select id="selectDynamicTableById" resultType="map">
	    SELECT * FROM ${tableName}
	    WHERE ${pkName} = #{id}
	</select>

    <!-- 根据外键删除子表数据 -->
    <delete id="deleteSubByForeignKey">
        DELETE FROM ${subTableName}
        WHERE ${fkName} = #{mainId}
    </delete>

    <!-- 查询子表数据 -->
    <select id="selectSubTableByFk" resultType="map">
        SELECT * FROM ${subTableName}
        WHERE ${fkName} = #{mainId}
    </select>

</mapper>
