<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.nexus</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-iot</artifactId>

    <description>
        iot物联网模块（设备接入/MQTT/数据采集/实时推送）
    </description>

    <dependencies>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- IoT 公共契约（IotAlert / IMesAndonService / IotDeviceDataQueryService），供 MES 共享 -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-iot</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-translation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-excel</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sensitive</artifactId>
        </dependency>

        <!-- Redis（Redis Streams 数据管道 + 设备最新值/在线状态缓存） -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- SSE 实时推送（设备实时数据/告警） -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-sse</artifactId>
        </dependency>

        <!-- 定时任务支持（数据清理/心跳检测/Stream修剪） -->
        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-common-job</artifactId>
        </dependency>

        <!-- MQTT Broker（Moquette 内嵌） -->
        <!-- 版本显式声明：未在 ruoyi-common-bom 管理；0.17 的 groupId 为 io.moquette -->
        <!-- T6 冲突排查：Moquette 0.17 声明 netty 4.1.93.Final + h2-mvstore 2.1.212；
             项目 redisson(ruoyi-common-redis) 声明在前且引入 netty 4.1.131.Final，
             Maven 最近优先策略收敛到 4.1.131(4.1.x 向后兼容)，无冲突 -->
        <dependency>
            <groupId>io.moquette</groupId>
            <artifactId>moquette-broker</artifactId>
            <version>0.17</version>
            <exclusions>
                <!-- 排除 slf4j-reload4j，避免与 Spring Boot 默认的 Logback 冲突 -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.nexus</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
